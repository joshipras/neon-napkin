# Optional. Set to the final production origin after deployment.
NEXT_PUBLIC_SITE_URL=

# Optional Vercel Web Analytics. Set to "1" to enable product event logging.
NEXT_PUBLIC_ENABLE_ANALYTICS=0

# Optional TV Mode realtime adapter.
# Local microphone and demo mode work without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
